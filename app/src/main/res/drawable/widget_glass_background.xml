<!-- XML clipToOutline is available from API31. Older hosts get a rounded material
     without an unclipped grain layer; they keep the same translucency and outline. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="270"
        android:startColor="#9B0A0A0A"
        android:centerColor="#99020202"
        android:endColor="#9B000000" />
    <corners android:radius="26dp" />
    <stroke android:width="1dp" android:color="#30FFFFFF" />
</shape>
