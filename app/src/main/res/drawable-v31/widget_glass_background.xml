<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Keep the first layer rounded: it supplies the widget's clipping outline. -->
    <item>
        <shape>
            <solid android:color="#99000000" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <!-- A tiny static tile adds grain without reading the wallpaper or scheduling work. -->
    <item>
        <bitmap
            android:src="@drawable/widget_frost_grain"
            android:tileMode="repeat" />
    </item>
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#06FFFFFF"
                android:centerColor="#01FFFFFF"
                android:endColor="#06000000" />
            <corners android:radius="26dp" />
            <stroke android:width="1dp" android:color="#30FFFFFF" />
        </shape>
    </item>
</layer-list>
